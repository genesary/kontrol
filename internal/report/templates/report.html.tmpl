<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="report:generated" content="{{.GeneratedAt}}">
<meta name="report:instance" content="{{.GitlabURL}}">
<title>Security posture report</title>
<link rel="stylesheet" href="static/css/app.css">
</head>
<body>
<a class="skip-link" href="#report">Skip to report</a>
<header class="masthead">
  <div class="masthead-inner">
    <div>
      <p class="eyebrow">OpenSSF Scorecard &middot; GitLab instance</p>
      <h1 class="masthead-title">Security posture report</h1>
      <p class="masthead-meta">
        {{with .GitlabURL}}<a class="link" href="{{.}}" target="_blank" rel="noopener noreferrer">{{.}}</a><span class="sep">&middot;</span>{{end}}
        Generated {{.GeneratedAt}}
      </p>
    </div>
    <div class="masthead-actions">
      <button id="export-csv" type="button" class="btn" title="Download every group and project as a spreadsheet">Export CSV</button>
      <button id="export-pdf" type="button" class="btn btn-primary" title="Opens your browser's print dialog, where you can save as PDF">Export PDF</button>
    </div>
  </div>
</header>
<main id="report" class="page">
  <nav class="crumbs" id="breadcrumb" aria-label="Report location"></nav>
  <div id="summary"></div>
  <div id="scan-error"></div>
  <div id="children"></div>
</main>
<div id="print-doc" class="print-doc" aria-hidden="true"></div>
<script id="report-data" type="application/json">{{.DataJSON}}</script>
<script id="check-docs-data" type="application/json">{{.CheckDocsJSON}}</script>
<script src="static/js/report.js"></script>
<script src="static/js/print.js"></script>
<script src="static/js/export.js"></script>
</body>
</html>
